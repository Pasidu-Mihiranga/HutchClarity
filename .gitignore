# This machine's staff accounts. The shared synthetic directory stays in git.
config/staff/local-directory.json

# Generated by `make licences`; the gate is in CI.
licences.json

# Evaluation report artefacts (A05); regenerate with `make eval`.
backend/.eval/

# Deterministic DATA01 exports; regenerate with `make synthetic-data`.
.generated/
# The browser suite's policy copy, built by `make dev-e2e` from the committed
# one. Generated, so it is never reviewed and never drifts from its source.
backend/.e2e-policy/

# ZAP scan output. `.zap/rules.tsv` is source and is committed; the report and
# the generated plan are artefacts of a run.
.zap/report.*
.zap/zap.yaml

# Playwright run artefacts (traces, videos, screenshots).
frontend/test-results/
frontend/playwright-report/
