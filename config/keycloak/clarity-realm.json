{
  "realm": "clarity",
  "enabled": true,
  "displayName": "Hutch Clarity simulated development realm",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "agent"
      },
      {
        "name": "supervisor"
      },
      {
        "name": "finance"
      },
      {
        "name": "vas_ops"
      },
      {
        "name": "cx_engineer"
      },
      {
        "name": "compliance"
      },
      {
        "name": "auditor"
      },
      {
        "name": "platform_admin"
      },
      {
        "name": "security_admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "clarity-api",
      "name": "Clarity API audience",
      "bearerOnly": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "clarity-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "clarity-mcp",
      "name": "Clarity MCP simulated client registry",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "clarity-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "clarity-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "clarity-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "secret": "clarity-development-only-mcp-secret",
      "optionalClientScopes": [
        "clarity.analytics",
        "clarity.customer-assist",
        "clarity.staff-assist"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-clarity-mcp",
      "enabled": true,
      "serviceAccountClientId": "clarity-mcp",
      "realmRoles": [
        "default-roles-clarity",
        "agent",
        "supervisor"
      ]
    }
  ],
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "clarity.customer-assist",
      "description": "MCP customer-assist tool profile: one bound case, read and propose.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "clarity.staff-assist",
      "description": "MCP staff-assist tool profile: the desk queue and any case.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "clarity.analytics",
      "description": "MCP analytics tool profile: rule catalogue and knowledge only.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ]
}
