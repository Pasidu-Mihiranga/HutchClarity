        {
          "name": "clarity-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "secret": "clarity-development-only-mcp-secret",
      "optionalClientScopes": [
        "clarity.analytics",
        "clarity.customer-assist",
        "clarity.staff-assist"
      ],
      "defaultClientScopes": [
        "basic",
        "acr"
      ]
    },
    {
      "clientId": "clarity-console",
      "name": "Clarity staff console (authorization code via the API)",
      "description": "SIMULATED development identity. The API performs the code exchange and the browser never sees a Keycloak token. Production federates HUTCH SSO and this client is replaced. REQUIRES HUTCH CONFIRMATION.",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "clarity-console-development-only",
      "redirectUris": [
        "http://localhost:8000/v1/auth/staff/oidc/callback",
        "http://127.0.0.1:8000/v1/auth/staff/oidc/callback",
        "http://localhost:8100/v1/auth/staff/oidc/callback",
        "http://127.0.0.1:8100/v1/auth/staff/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3101/*##http://127.0.0.1:3101/*",
        "acr.loa.map": "{\"password\": \"1\", \"mfa\": \"2\"}"
      },
      "protocolMappers": [
        {
          "name": "clarity-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "clarity-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "clarity-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "acr"
      ]
    }
  ],
