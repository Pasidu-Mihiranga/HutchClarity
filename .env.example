# Copy to .env and adjust. Never commit .env.
#
# Every variable here is declared in backend/src/clarity/app/settings.py, which
# is the only code that reads the environment (B07, I20). A variable missing
# from this file fails tests/architecture/test_settings.py.
#
# The defaults run the whole app with no infrastructure: leave everything unset
# and `make dev` works (ADR-0006).

# -- profile ------------------------------------------------------------------
# lite (= demo, Python only, in memory) | full (real components) | prod (not implemented)
CLARITY_PROFILE=lite

# -- data ---------------------------------------------------------------------
# Required by the full profile, which refuses to start without it. Unset in the
# demo profile: nothing is persisted.
DATABASE_URL=postgresql+psycopg://clarity:clarity@localhost:5432/clarity

# -- messaging ----------------------------------------------------------------
# Unset: the in-process event bus. Set: the Kafka driver, which also needs the
# kafka extra (pip install -e backend[kafka]) and a broker (make up-full).
CLARITY_KAFKA_BOOTSTRAP=

# -- simulated HUTCH estate --------------------------------------------------
# The full profile uses HTTP drivers against this development-only service.
# The lite profile keeps the same synthetic adapters in process.
CLARITY_HUTCH_SIM_URL=http://localhost:8090
CLARITY_HUTCH_SIM_TIMEOUT=3

# -- identity and crypto ------------------------------------------------------
# Keys the subscriber_ref pseudonym. A real deployment sets its own.
SUBSCRIBER_HMAC_KEY=clarity-demo-subscriber-key-not-a-secret
# Ed25519 key for Trust Receipts. Generate a local one with `make keys`.
SIGNING_KEY_PATH=.keys/signing.pem
KEYS_DIR=.keys
# Unset: local customer/dev issuer and Python authorization. Set in full to use
# the simulated Keycloak realm and OPA service from deploy/compose/full.yml.
CLARITY_KEYCLOAK_ISSUER=
CLARITY_KEYCLOAK_AUDIENCE=clarity-api
CLARITY_KEYCLOAK_JWKS_URL=
CLARITY_OPA_URL=
CLARITY_AUTH_TIMEOUT=3
# Unset: the lite Ed25519 signer. Set these for OpenBao Transit in full.
CLARITY_SIGNER_URL=
CLARITY_SIGNER_TOKEN=
CLARITY_SIGNER_KEY_NAME=clarity-receipts
CLARITY_SIGNER_MOUNT=transit
CLARITY_SIGNER_NAMESPACE=
CLARITY_SIGNER_TIMEOUT=3

# -- policy artefacts ---------------------------------------------------------
# Unset: found by walking up from the package, so a checkout needs no paths.
CLARITY_RULES_DIR=
CLARITY_POLICY_DIR=

# -- AI -----------------------------------------------------------------------
# Unset: no model at all. The gateway answers from CX-approved templates and
# spends no tokens, which is the default the deck promises (ADR-0009).
# Use your own provider key; never commit one.
CLARITY_MODEL_BASE_URL=
CLARITY_MODEL_NAME=local-model
CLARITY_MODEL_API_KEY=
CLARITY_MODEL_TIMEOUT=20
AI_PREFER_TEMPLATES=true
AI_CASSETTE_DIR=cassettes

# -- interfaces ---------------------------------------------------------------
# The base a receipt's verify URL and QR code point at.
VERIFY_BASE=http://localhost:8000/v

# -- observability ------------------------------------------------------------
# console (lite) | otlp (full, needs the endpoint below) | none
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
# text (readable in a terminal) | json (for a log pipeline)
CLARITY_LOG_FORMAT=text
