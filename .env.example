# Copy to .env and adjust. Never commit .env.
#
# Every variable here is declared in backend/src/clarity/app/settings.py, which
# is the only code that reads the environment (B07, I20). A variable missing
# from this file fails tests/architecture/test_settings.py.
#
# The defaults run the whole app with no infrastructure: leave everything unset
# and `make dev` works (ADR-0006).

# -- profile ------------------------------------------------------------------
# lite (= demo, Python only, in memory) | full (real components) | prod (not implemented)
CLARITY_PROFILE=lite

# -- data ---------------------------------------------------------------------
# Required by the full profile, which refuses to start without it. Unset in the
# demo profile: nothing is persisted.
DATABASE_URL=postgresql+psycopg://clarity:clarity@localhost:5432/clarity

# -- messaging ----------------------------------------------------------------
# Unset: the in-process event bus. Set: the Kafka driver, which also needs the
# kafka extra (pip install -e backend[kafka]) and a broker (make up-full).
CLARITY_KAFKA_BOOTSTRAP=

# -- simulated HUTCH estate --------------------------------------------------
# The full profile uses HTTP drivers against this development-only service.
# The lite profile keeps the same synthetic adapters in process.
CLARITY_HUTCH_SIM_URL=http://localhost:8090
CLARITY_HUTCH_SIM_TIMEOUT=3

# -- identity and crypto ------------------------------------------------------
# Keys the subscriber_ref pseudonym. A real deployment sets its own.
SUBSCRIBER_HMAC_KEY=clarity-demo-subscriber-key-not-a-secret
# Ed25519 key for Trust Receipts. Generate a local one with `make keys`.
SIGNING_KEY_PATH=.keys/signing.pem
KEYS_DIR=.keys
# Unset: local customer/dev issuer and Python authorization. Set in full to use
# the simulated Keycloak realm and OPA service from deploy/compose/full.yml.
CLARITY_KEYCLOAK_ISSUER=
CLARITY_KEYCLOAK_AUDIENCE=clarity-api
CLARITY_KEYCLOAK_JWKS_URL=
# JSON staff accounts. When either is set, POST /v1/auth/staff/session is 404
# and POST /v1/auth/staff/login assigns the role. Inline JSON wins over the file.
# The synthetic file is for local dev and e2e only. A deployment uses its own.
# Staff single sign-on through the provider (B1). All three must be set before
# the OIDC routes exist: a confidential client with no secret is a public
# client nobody decided to make public, so a half-configured SSO is off rather
# than silently weaker.
CLARITY_OIDC_CLIENT_ID=clarity-console
CLARITY_OIDC_CLIENT_SECRET=
CLARITY_OIDC_REDIRECT_URI=
# Where a completed sign-in returns the browser to.
CLARITY_CONSOLE_BASE_URL=http://127.0.0.1:3101
# Browser origins allowed to call this API with credentials. The wildcard is
# not an option: CORS forbids it with credentials, and the console signs in
# with a cookie.
CLARITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3101,http://127.0.0.1:3101,http://localhost:3102,http://127.0.0.1:3102,http://localhost:3100,http://127.0.0.1:3100
# Whether the staff session cookie carries Secure. False only for local http.
CLARITY_COOKIE_SECURE=false
CLARITY_STAFF_DIRECTORY=
CLARITY_STAFF_DIRECTORY_FILE=
CLARITY_OPA_URL=
# The clarity-mcp deployable (A04, ADR-0018). Run it with
# `uvicorn clarity.entrypoints.mcp_asgi:app`; it serves MCP at /mcp.
# This server's own identifier, used as the RFC 8707 resource indicator.
CLARITY_MCP_RESOURCE_URL=http://localhost:8081/mcp
# Host headers the MCP server answers to, comma separated. Unset: the host in
# CLARITY_MCP_RESOURCE_URL. This is the DNS-rebinding defence; never a wildcard.
CLARITY_MCP_ALLOWED_HOSTS=
# clarity-api, which clarity-mcp calls for every tool. It has no database.
CLARITY_MCP_API_URL=http://localhost:8000
# RFC 8693 token-exchange endpoint. Unset: downstream calls are refused rather
# than forwarding the client's token, which ADR-0018 forbids.
CLARITY_MCP_EXCHANGE_URL=
CLARITY_AUTH_TIMEOUT=3
# Unset: the lite Ed25519 signer. Set these for OpenBao Transit in full.
CLARITY_SIGNER_URL=
CLARITY_SIGNER_TOKEN=
CLARITY_SIGNER_KEY_NAME=clarity-receipts
CLARITY_SIGNER_MOUNT=transit
CLARITY_SIGNER_NAMESPACE=
CLARITY_SIGNER_TIMEOUT=3

# -- policy artefacts ---------------------------------------------------------
# Unset: found by walking up from the package, so a checkout needs no paths.
CLARITY_RULES_DIR=
CLARITY_POLICY_DIR=
# Conversation flows (C02): policy content, published like a rule pack.
# Defaults to config/flows next to the repository root.
CLARITY_FLOWS_DIR=
# Retrieval parameters: top-k, BM25 constants, rerank bonuses (K02).
CLARITY_RETRIEVAL_FILE=
# HMAC secret the channel gateway verifies inbound webhooks against (N02).
# Unset: every webhook is refused, which is the safe direction. The /sim/*
# simulator routes do not use it.
CLARITY_CHANNEL_WEBHOOK_SECRET=

# -- WhatsApp transport ------------------------------------------------------
# Disabled by default. Baileys is an unofficial WhatsApp Web client. Auth
# state must be a persistent secret volume, never a repository path. Pairing
# is an operator command and has no HTTP route.
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_DIR=/var/lib/clarity-whatsapp/auth
WHATSAPP_GATEWAY_URL=http://clarity-channel-gateway:8102/webhooks/whatsapp
WHATSAPP_HEALTH_PORT=8104
WHATSAPP_PAIRING_PHONE=

# -- AI -----------------------------------------------------------------------
# Unset: no model at all. The gateway answers from CX-approved templates and
# spends no tokens, which is the default the deck promises (ADR-0009).
# Use your own provider key; never commit one.
CLARITY_MODEL_BASE_URL=
CLARITY_MODEL_NAME=local-model
CLARITY_MODEL_API_KEY=
CLARITY_MODEL_TIMEOUT=20
# Vertex AI. ADC reads GOOGLE_APPLICATION_CREDENTIALS; the file stays outside
# the repository. Text roles use CLARITY_MODEL_NAME (gemini-2.5-flash).
# AI_PREFER_TEMPLATES must be false or the template tier still answers.
CLARITY_VERTEX_PROJECT=
CLARITY_VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
AI_PREFER_TEMPLATES=true
AI_CASSETTE_DIR=cassettes
# Record model responses instead of replaying them (A02). Needs a provider
# configured above. Leave unset: tests replay, and the suite blocks the network.
CLARITY_RECORD_CASSETTES=
# Model roles and their provider chains. Unset: config/ai/models.yaml, found by
# walking up from the package. Code asks for a role, never a model ID (I12).
CLARITY_MODELS_FILE=

# Customer OTP SMS through a registered httpSMS Android phone. Set both or
# neither. The API key must be the primary user key, not a pk_ phone key.
HTTPSMS_API_KEY=
HTTPSMS_SENDER=
HTTPSMS_BASE_URL=https://api.httpsms.com/v1
HTTPSMS_TIMEOUT=10
# Real phones that sign in (SMS, chat, WhatsApp) as a synthetic customer:
# real=synthetic pairs, comma separated. Only these numbers get a real SMS;
# every synthetic number's code stays on the sign-in page, and an unknown
# number gets nothing. Set on the server only, never with real numbers here.
CLARITY_LINKED_PHONES=

# -- interfaces ---------------------------------------------------------------
# The base a receipt's verify URL and QR code point at. This is the public
# verify app (`make web-verify`), not the API: the API serves no pages.
VERIFY_BASE=http://localhost:3002/r

# -- audit --------------------------------------------------------------------
# Start even when the audit trail fails verification (ADR-0034). Incident use
# only: the start is itself recorded as break-glass. Leave false.
CLARITY_AUDIT_BREAK_GLASS=false
# OpenBao Transit key for signed audit checkpoints (ADR-0035). Separate from
# the receipt key. Without OpenBao, `full` keeps a local key in KEYS_DIR.
CLARITY_AUDIT_SIGNER_KEY_NAME=clarity-audit-checkpoints
# Encrypts audit backup bundles (Phase 6). Unset: a backup is refused rather
# than written in the clear. Set a 32-byte random value of your own; any length
# works and is hashed to the key. Never commit a real one (I14).
CLARITY_AUDIT_BACKUP_KEY=
# Where bundles are written. A mounted volume or an object-store mount in full.
CLARITY_AUDIT_BACKUP_DIR=.backups

# -- observability ------------------------------------------------------------
# console (lite) | otlp (full, needs the endpoint below) | none
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
# text (readable in a terminal) | json (for a log pipeline)
CLARITY_LOG_FORMAT=text
